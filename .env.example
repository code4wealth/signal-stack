# Copy to .env and fill in. .env is gitignored.
# Groq API key (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Groq model. Free-tier models change; verify at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# SQLAlchemy URL. Leave commented to use backend/signalstack.db (the default).
# Relative URLs resolve against the current working directory, so ./signalstack.db would put a
# SECOND database beside the repo root. Swap for postgresql+psycopg://... to move to Postgres.
# DATABASE_URL=sqlite:///./signalstack.db

# Pipeline guard rails (PRD section 9 / section 14)
MAX_ANALYSES_PER_RUN=40
CRAWL_CONCURRENCY=4
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=3145728
FETCH_REQUESTS_PER_SECOND=1
USER_AGENT=SignalStackBot/0.1 (research bot; contact in README)
ENABLE_SCHEDULER=0

# Frontend (Next.js)
# BACKEND_URL is used by the Next server-side rewrite; the browser never calls it directly.
BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL: set only for a split deployment (absolute backend origin, must be CORS-allowed).
NEXT_PUBLIC_API_URL=

# Extra allowed browser origins for the API (comma separated), e.g. your deployed frontend.
CORS_EXTRA_ORIGINS=
